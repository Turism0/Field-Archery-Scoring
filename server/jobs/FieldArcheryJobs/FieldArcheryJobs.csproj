<Project Sdk="Microsoft.NET.Sdk">

  <!-- Background jobs for the Field Archery Scoring server: fetches the NFAS championship results and fits the
       handicap. Run by Windows Task Scheduler on Odin (see Update-Jobs.ps1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FieldArcheryJobs</RootNamespace>
    <Version>2.2.03</Version>
    <InformationalVersion>2.2.03</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Verify\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
