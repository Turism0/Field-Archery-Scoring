<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the local database (scores and profile) goes into the user's own backup.
     The sign-in token (shared_prefs/fieldarchery_account.xml) is not included, so a restored phone signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="fieldarchery.db" />
        <!-- Whose rounds those are (3.2.02), so a restored phone keeps them for that account and clears them for another. -->
        <include domain="sharedpref" path="device_data.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="fieldarchery.db" />
        <include domain="sharedpref" path="device_data.xml" />
    </device-transfer>
</data-extraction-rules>
